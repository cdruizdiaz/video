node_modules
dist
.DS_Store
.env

# Renders (out/<ID>/revision y out/<ID>/final): no se versionan
out

# Temporales (búsquedas de Mixkit, pruebas)
tmp/

# Configuración local de Claude Code (permisos de esta PC)
.claude/settings.local.json

# ---- public/ ----
# Trabajos: se versionan los datos (JSON) y los .gitkeep; NO los crudos, audios ni imágenes pesadas
public/trabajos/*/crudos/*
public/trabajos/*/audio/*
public/trabajos/*/img/*
!public/trabajos/*/*/.gitkeep

# Biblioteca compartida (Mixkit): no se versionan los audios, sí el registro de licencias
public/biblioteca/**/*.*
!public/biblioteca/**/.gitkeep
!public/biblioteca/LICENCIAS-mixkit.json

# Herramientas y archivos temporales pesados
.venv/
*.wav
whisper.cpp/
modelos-whisper/

# Python
__pycache__/

# Capas 3D renderizadas en caché (scripts/capa3d.mjs): se regeneran
public/trabajos/*/cache3d/
!public/biblioteca/**/LICENCIAS.md
