  "segmentos": [
    {
      "desdeMs": 0,
      "hastaMs": 9120,
      "texto": "So, this question of love is really an extraordinary thing, because a mind that is frightened,"
    },
    {
      "desdeMs": 9120,
      "hastaMs": 12000,
      "texto": "obviously, cannot love."
    },
    {
      "desdeMs": 12000,
      "hastaMs": 20680,
      "texto": "A mind that is self-concerned with its own ambitions, greed, fears, guilt, suffering,"
    },
    {
      "desdeMs": 20680,
      "hastaMs": 26242,
      "texto": "has no capacity to love."
    },
    {
      "desdeMs": 26242,
      "hastaMs": 36553,
      "texto": "A mind that is divided in itself, that lives in fragments, obviously, cannot love."
    },
    {
      "desdeMs": 36553,
      "hastaMs": 43933,
      "texto": "A mind that lives in division."
    },
    {
      "desdeMs": 43933,
      "hastaMs": 45893,
      "texto": "Division implies sorrow."
    },
    {
      "desdeMs": 45893,
      "hastaMs": 52493,
      "texto": "That is the root cause of sorrow, division, between you and me, between me and they, or"
    },
    {
      "desdeMs": 52493,
      "hastaMs": 53548,
      "texto": "we and they."
    }
  ],
