      "hastaMs": 33343,
      "texto": "Pasó."
    },
    {
      "desdeMs": 34003,
      "hastaMs": 37183,
      "texto": "Pasamos del papel ilustrator y de ilustrator a la nave..."
    },
    {
      "desdeMs": 37183,
      "hastaMs": 39423,
      "texto": "Sí, a la qué?"
    },
    {
      "desdeMs": 40023,
      "hastaMs": 41383,
      "texto": "A la animación. Bien."
    },
    {
      "desdeMs": 41863,
      "hastaMs": 44823,
      "texto": "Pasamos del papel ilustrator y de ilustrator a la nevga."
    },
    {
      "desdeMs": 45892,
      "hastaMs": 46732,
      "texto": "A la animación."
    },
    {
      "desdeMs": 47092,
      "hastaMs": 48432,
      "texto": "A la navegación, digo."
    },
    {
      "desdeMs": 49104,
