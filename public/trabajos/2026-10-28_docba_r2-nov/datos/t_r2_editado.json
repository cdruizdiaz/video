    {
      "desdeMs": 0,
      "hastaMs": 2640,
      "texto": "¿Necesitas un espacio para cerrar el año con tu equipo?"
    },
    {
      "desdeMs": 2640,
      "hastaMs": 4840,
      "texto": "Dogba es el lugar indicado."
    },
    {
      "desdeMs": 4840,
      "hastaMs": 7680,
      "texto": "Hay proyectos que nacieron, otros que tuvieron obstáculos"
    },
    {
      "desdeMs": 7680,
      "hastaMs": 9600,
      "texto": "y otros que llegaron a su fin."
    },
    {
      "desdeMs": 9600,
      "hastaMs": 11520,
      "texto": "Todos merecen una celebración."
    },
    {
      "desdeMs": 11520,
      "hastaMs": 14040,
      "texto": "En Dogba tenemos un espacio amplio, variedad gastronómica"
    },
    {
      "desdeMs": 14040,
      "hastaMs": 16840,
      "texto": "y un servicio con todas las comodidades."
    },
    {
      "desdeMs": 16840,
      "hastaMs": 18560,
      "texto": "Como en casa, pero sin lavar un plato."
    },
    {
      "desdeMs": 18560,
      "hastaMs": 21240,
      "texto": "Reserva tu fin de año en Dogba o simplemente pasen a brindar."
    }
