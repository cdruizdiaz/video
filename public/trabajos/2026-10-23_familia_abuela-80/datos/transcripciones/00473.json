    {
      "desdeMs": 0,
      "hastaMs": 4120,
      "texto": "A ver, acá tenemos a la reina, pero ¿cuántas princesas tenemos?"
    },
    {
      "desdeMs": 5700,
      "hastaMs": 8940,
      "texto": "Esta es para mi mamá, Pam, de Karina, la princesita."
    },
    {
      "desdeMs": 9360,
      "hastaMs": 10280,
      "texto": "¡Vale, Galiá!"
    },
    {
      "desdeMs": 10500,
      "hastaMs": 11220,
      "texto": "¡Vale, mamá!"
    },
    {
      "desdeMs": 14560,
      "hastaMs": 15800,
      "texto": "¡No me ha hecho nada!"
    },
    {
      "desdeMs": 15840,
      "hastaMs": 18000,
      "texto": "¡Se canso de tus mentiras!"
    },
    {
      "desdeMs": 19760,
      "hastaMs": 20620,
      "texto": "¡Ahí está, tícate!"
    },
    {
      "desdeMs": 21680,
      "hastaMs": 24520,
      "texto": "¡Se la pejo a la pata! ¡Se la pejo a la pata la Dali!"
    },
    {
      "desdeMs": 26600,
      "hastaMs": 30080,
      "texto": "¿Y sabés que la Dali está disfrutando cuando arranca con este?"
    },
    {
      "desdeMs": 32260,
      "hastaMs": 34680,
      "texto": "¡Se acabó!"
    },
    {
      "desdeMs": 34680,
      "hastaMs": 36580,
      "texto": "¡Vámonos, se acabó!"
    },
    {
      "desdeMs": 36800,
      "hastaMs": 39740,
      "texto": "¡Tu mentiras se acabó!"
    },
    {
      "desdeMs": 40300,
      "hastaMs": 41400,
      "texto": "¡Se acabó!"
    },
    {
      "desdeMs": 41420,
      "hastaMs": 42080,
      "texto": "¿Y yo digo qué?"
    },
    {
      "desdeMs": 42940,
      "hastaMs": 48340,
      "texto": "¡Basta, basta, basta, perdí, oh, soy corazón perdido!"
    },
    {
      "desdeMs": 48360,
      "hastaMs": 49600,
      "texto": "¡Vaya a la próxima!"
    },
    {
      "desdeMs": 50960,
      "hastaMs": 51960,
      "texto": "¡Vámonos de líneas!"
    }
