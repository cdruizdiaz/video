    {
      "desdeMs": 0,
      "hastaMs": 4000,
      "texto": "- ¡Ramón! - ¡Dale Ramón!"
    },
    {
      "desdeMs": 6000,
      "hastaMs": 8000,
      "texto": "- ¡La gurisa!"
    },
    {
      "desdeMs": 10000,
      "hastaMs": 12000,
      "texto": "- ¡Y la risai!"
    },
    {
      "desdeMs": 12000,
      "hastaMs": 14000,
      "texto": "- ¡Gesai!"
    },
    {
      "desdeMs": 14000,
      "hastaMs": 16000,
      "texto": "- ¡Gesai!"
    },
    {
      "desdeMs": 16000,
      "hastaMs": 18000,
      "texto": "- ¡Gesai!"
    },
    {
      "desdeMs": 18000,
      "hastaMs": 20000,
      "texto": "- ¡Gesai!"
    },
    {
      "desdeMs": 22000,
      "hastaMs": 26000,
      "texto": "- Y sin más dos puntos, por vida, ¡Ramón!"
    },
    {
      "desdeMs": 30000,
      "hastaMs": 39920,
      "texto": "¡Es un robo esto! ¡Vamos a dar el premio!"
    },
    {
      "desdeMs": 46000,
      "hastaMs": 46940,
      "texto": "¡Es un robo!"
    },
    {
      "desdeMs": 46940,
      "hastaMs": 48760,
      "texto": "¡No! ¡Pero ese de la bonita!"
    },
    {
      "desdeMs": 50440,
      "hastaMs": 52780,
      "texto": "¡Sí! ¡Si yo entiendo la foto de mi mamá!"
    },
    {
      "desdeMs": 53200,
      "hastaMs": 57120,
      "texto": "El hijo de la tía Moni, por ser el favorito y discutido de toda la familia,"
    },
    {
      "desdeMs": 57560,
      "hastaMs": 60700,
      "texto": "siempre presente en las reuniones y protagonista de más fotos que cualquiera."
    },
    {
      "desdeMs": 60700,
      "hastaMs": 61380,
      "texto": "¡No te da bola!"
    },
    {
      "desdeMs": 62940,
      "hastaMs": 66180,
      "texto": "Porque si hay una cámara cerca, Ramón tiene que aparecer."
    },
    {
      "desdeMs": 66620,
      "hastaMs": 70080,
      "texto": "Un verdadero consentido de la familia que asistió a todas las miradas y los calles."
    },
    {
      "desdeMs": 70400,
      "hastaMs": 71480,
      "texto": "¡Vamos Ramón!"
    }
  ],
