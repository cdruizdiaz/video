    },
    {
      "desdeMs": 12000,
      "hastaMs": 15000,
      "texto": "Las empanadas, toda la comida se va a echar a perder, se va a enfriar."
    },
    {
      "desdeMs": 15000,
      "hastaMs": 18000,
      "texto": "No lo puedo creer. Buddy nunca nos dejaría hacer esto."
    },
    {
      "desdeMs": 18000,
      "hastaMs": 21000,
      "texto": "Buddy nunca haría esto. ¿Dónde estás, Buddy?"
