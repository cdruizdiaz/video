  "segmentos": [
    {
      "desdeMs": 0,
      "hastaMs": 29980,
      "texto": "Un cañolito en el aire, una esperanza, corazóncito ardiendo como una brasa, corazóncito ardiendo como una casa, corazóncito ardiendo como una casa."
    },
    {
      "desdeMs": 30000,
      "hastaMs": 43380,
      "texto": "Vengo desde el morasta, para las chiquitas, traigo una flor del aire, de la lomita."
    },
    {
      "desdeMs": 43380,
      "hastaMs": 50000,
      "texto": "Papi, chino, gasteña, mi niña, niña chiquita."
    },
    {
      "desdeMs": 54000,
      "hastaMs": 68000,
      "texto": "Para decirte cuanto te quiero, salí con destino a la picada, y en el camino su linda cara pintaba el sol."
    },
    {
      "desdeMs": 68000,
      "hastaMs": 80000,
      "texto": "Por hora y elmas en las mañanas, yo de Taperco y de Alpargana, viendo el paisaje de la picada."
    },
    {
      "desdeMs": 80000,
      "hastaMs": 87000,
      "texto": "No sé por qué cuentes que saben nada, que alegremente alguien así me ha..."
    }
  ],
