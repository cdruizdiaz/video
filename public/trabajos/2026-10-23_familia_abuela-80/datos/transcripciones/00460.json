    {
      "desdeMs": 600,
      "hastaMs": 6000,
      "texto": "Huevo, huevo, huevo, huevo, huevo, huevo, huevo, huevo, huevo, huevo, huevo."
    },
    {
      "desdeMs": 6300,
      "hastaMs": 12000,
      "texto": "Olé, olé, olé, olé, huevo, huevo."
    },
    {
      "desdeMs": 12520,
      "hastaMs": 14600,
      "texto": "El ganador es la noche."
    },
    {
      "desdeMs": 14600,
      "hastaMs": 15500,
      "texto": "¡Cuchá, escuché!"
    },
    {
      "desdeMs": 15660,
      "hastaMs": 20120,
      "texto": "... las competencias más reñidas de la noche, disputadas entre Claudio, Patito y Alberto."
    },
    {
      "desdeMs": 20860,
      "hastaMs": 25300,
      "texto": "Después de las largas deliberaciones, la edición se tomó por antigüedad la familia rutina."
    },
    {
      "desdeMs": 26160,
      "hastaMs": 32620,
      "texto": "Claudio se consagra como el indiscutido ganador, destacándose por llegar a cada lugar y brillar con su enorme pelada."
    },
    {
      "desdeMs": 33080,
      "hastaMs": 35660,
      "texto": "Es de impecable y con luz propia."
    },
    {
      "desdeMs": 35880,
      "hastaMs": 36260,
      "texto": "¡Vamos!"
    }
  ],
