    {
      "desdeMs": 0,
      "hastaMs": 2300,
      "texto": "Un aplauso para Javi, por siempre, que está en la presentación."
    },
    {
      "desdeMs": 2320,
      "hastaMs": 2940,
      "texto": "¡Bravo, papá!"
    },
    {
      "desdeMs": 3360,
      "hastaMs": 3800,
      "texto": "¡Dale!"
    },
    {
      "desdeMs": 6520,
      "hastaMs": 8000,
      "texto": "¡No, no, no, no!"
    },
    {
      "desdeMs": 8620,
      "hastaMs": 9700,
      "texto": "¡No, no, no, no!"
    },
    {
      "desdeMs": 11280,
      "hastaMs": 14640,
      "texto": "¡Cuánto quiero en matemáticas, boltero!"
    },
    {
      "desdeMs": 15560,
      "hastaMs": 18060,
      "texto": "¡Arreglamos para la clase de matemáticas!"
    },
    {
      "desdeMs": 18960,
      "hastaMs": 25260,
      "texto": "La siguiente categoría es la persona de las familias más probables a hacer el semillonario."
    },
    {
      "desdeMs": 25260,
      "hastaMs": 28260,
      "texto": "Y los nominados son..."
    },
    {
      "desdeMs": 28260,
      "hastaMs": 30260,
      "texto": "Javi Pujera."
    },
    {
      "desdeMs": 33260,
      "hastaMs": 34820,
      "texto": "¡Bravo de la provincia!"
    },
    {
      "desdeMs": 37640,
      "hastaMs": 40380,
      "texto": "El menos importante es Cerebra Vida."
    },
    {
      "desdeMs": 40640,
      "hastaMs": 41680,
      "texto": "¡Dale, salto!"
    },
    {
      "desdeMs": 47020,
      "hastaMs": 50260,
      "texto": "Y el ganador es..."
    },
    {
      "desdeMs": 50800,
      "hastaMs": 51780,
      "texto": "¡Cerebra Vida!"
    },
    {
      "desdeMs": 56520,
      "hastaMs": 57760,
      "texto": "¡Vamos, brazos!"
    },
    {
      "desdeMs": 57760,
      "hastaMs": 59260,
      "texto": "¡Aguanta el rastro, va!"
    },
    {
      "desdeMs": 59260,
      "hastaMs": 60300,
      "texto": "¡Aguanta el rastro!"
    },
    {
      "desdeMs": 60820,
      "hastaMs": 61840,
      "texto": "La ganadora es Serena."
    },
    {
      "desdeMs": 62280,
      "hastaMs": 67360,
      "texto": "Mientras algunos, como Clave Javito, tuvieron su oportunidad y cada vez en el tren de la riqueza ya se les pasó."
    },
    {
      "desdeMs": 69240,
      "hastaMs": 74680,
      "texto": "Serena viene empezando fuerte con una querida entusiasmo, gran capacidad de higienía."
    },
    {
      "desdeMs": 75120,
      "hastaMs": 77760,
      "texto": "Estuvo a punta a que será la próxima millonaria de la familia."
    },
    {
      "desdeMs": 77760,
      "hastaMs": 81780,
      "texto": "Y por supuesto, la encarga de financiar las próximas vacaciones familiares."
    },
    {
      "desdeMs": 81780,
      "hastaMs": 82220,
      "texto": "¡Bravo!"
    }
