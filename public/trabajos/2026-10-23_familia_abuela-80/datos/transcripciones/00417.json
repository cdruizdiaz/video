  "segmentos": [
    {
      "desdeMs": 0,
      "hastaMs": 3640,
      "texto": "Ya, quiero que me hayan de comer."
    },
    {
      "desdeMs": 5680,
      "hastaMs": 10340,
      "texto": "Está llegando la canción. Falta que llegue la gente. Falta que llegue el nadie."
    },
    {
      "desdeMs": 10340,
      "hastaMs": 16880,
      "texto": "Ya ensayamos, ya ensayamos la canción con los de mierda de los primos que no quiero."
    },
    {
      "desdeMs": 16880,
      "hastaMs": 20220,
      "texto": "O sea, hoy jurábamos difícil, el jurán."
    },
    {
      "desdeMs": 20220,
      "hastaMs": 22720,
      "texto": "Se viene de ahí. No puede ser robada."
    },
    {
      "desdeMs": 22720,
      "hastaMs": 24860,
      "texto": "Bueno, ya le hicieron ropa."
    },
    {
      "desdeMs": 24860,
      "hastaMs": 26560,
      "texto": "Diego, éxitos con tu bebé."
    },
    {
      "desdeMs": 26560,
      "hastaMs": 27820,
      "texto": "¿Qué habla de chona, Ananí?"
    },
    {
      "desdeMs": 27820,
      "hastaMs": 29720,
      "texto": "Es que esa no era querida a la chica."
    },
    {
      "desdeMs": 29720,
      "hastaMs": 31720,
      "texto": "Bueno, voy a cortar."
    },
    {
      "desdeMs": 31720,
      "hastaMs": 34220,
      "texto": "Yo de los niños me he crecido mucho."
    },
    {
      "desdeMs": 34220,
      "hastaMs": 36700,
      "texto": "A ver, por eso me quedo mal."
    },
    {
      "desdeMs": 36700,
      "hastaMs": 37720,
      "texto": "¿Opiñones, Mila?"
    },
    {
      "desdeMs": 37720,
      "hastaMs": 39220,
      "texto": "Me gusta, a ver cómo se va."
    },
    {
      "desdeMs": 39220,
      "hastaMs": 42240,
      "texto": "Eh, no tengo mucha hambre."
    },
    {
      "desdeMs": 42240,
      "hastaMs": 44740,
      "texto": "No merendé nada, por razón, tengo madre."
    },
    {
      "desdeMs": 44740,
      "hastaMs": 47980,
      "texto": "Ojalá nos pasen ahora una empanadita."
    },
    {
      "desdeMs": 47980,
      "hastaMs": 52880,
      "texto": "No voy a poner nada de tu parte, no puede ser tan grosera."
    },
    {
      "desdeMs": 52880,
      "hastaMs": 54980,
      "texto": "Bueno, Deco."
    },
    {
      "desdeMs": 54980,
      "hastaMs": 58560,
      "texto": "Yo estuve cortando las masillitas malatinas."
    }
  ],
