  "segmentos": [
    {
      "desdeMs": 0,
      "hastaMs": 4000,
      "texto": "Y hoy, con una hora de tardanza, Amalia..."
    },
    {
      "desdeMs": 8000,
      "hastaMs": 11000,
      "texto": "Nadie le abusó, nadie le abusó de esto..."
    },
    {
      "desdeMs": 11000,
      "hastaMs": 13000,
      "texto": "Y ganó..."
    },
    {
      "desdeMs": 13000,
      "hastaMs": 15000,
      "texto": "¡Amalia!"
    },
    {
      "desdeMs": 17000,
      "hastaMs": 19000,
      "texto": "¡A buscar! ¡A buscar! ¡A buscar! ¡A buscar!"
    },
    {
      "desdeMs": 27000,
      "hastaMs": 29000,
      "texto": "Bueno, la ganadora juega, Amalia..."
    },
    {
      "desdeMs": 30000,
      "hastaMs": 33000,
      "texto": "Por llegar tarde, hay operables eventos familiares."
    },
    {
      "desdeMs": 33000,
      "hastaMs": 36000,
      "texto": "Por esas siestas que se le van un poquito de las manos"
    },
    {
      "desdeMs": 36000,
      "hastaMs": 38000,
      "texto": "y por hacer esperar a todos."
    },
    {
      "desdeMs": 38000,
      "hastaMs": 41000,
      "texto": "Incluso cuando hay partidos del club, que empiezan a colar y todo."
    },
    {
      "desdeMs": 42000,
      "hastaMs": 44000,
      "texto": "Pero si hablamos de imposibilidad,"
    },
    {
      "desdeMs": 44000,
      "hastaMs": 46000,
      "texto": "el cansamiento de su hija Claudia merece un medicamento."
    },
    {
      "desdeMs": 52000,
      "hastaMs": 54000,
      "texto": "El del maquillaje que no sobrevivió a una ducha,"
    },
    {
      "desdeMs": 54000,
      "hastaMs": 56000,
      "texto": "espero que decidió no cooperar."
    },
    {
      "desdeMs": 56000,
      "hastaMs": 58000,
      "texto": "Las medias de seda que estaban rotas."
    },
    {
      "desdeMs": 58000,
      "hastaMs": 61000,
      "texto": "Y la lucha interminable para vivir sobre las nuevas."
    },
    {
      "desdeMs": 61000,
      "hastaMs": 66000,
      "texto": "Amalia tuvo que enfrentarse a una verdadera carrera contra el reloj."
    },
    {
      "desdeMs": 66000,
      "hastaMs": 68000,
      "texto": "Porque si algo me enseñó Amalia,"
    },
    {
      "desdeMs": 68000,
      "hastaMs": 73000,
      "texto": "es que siempre puede surgir un listo más junto a uno."
    }
  ],
