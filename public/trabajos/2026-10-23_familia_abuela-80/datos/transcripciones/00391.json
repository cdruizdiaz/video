    {
      "desdeMs": 0,
      "hastaMs": 10000,
      "texto": "Y para que tenga la bendición de Dios va a ir el Padre Carlos Joaquín, el cura párroco."
    },
    {
      "desdeMs": 14000,
      "hastaMs": 18000,
      "texto": "Espero que no te avergüences de los shows de la noche."
    },
    {
      "desdeMs": 19000,
      "hastaMs": 20000,
      "texto": "Espero que sea..."
    },
    {
      "desdeMs": 21000,
      "hastaMs": 22000,
      "texto": "¿Apto para todo público?"
    },
    {
      "desdeMs": 23000,
      "hastaMs": 26000,
      "texto": "No sé, no importa. Nosotros no nos importa mucho. Es para vos."
    },
    {
      "desdeMs": 27000,
      "hastaMs": 35000,
      "texto": "Tiene que ser dentro de un límite de la decencia y de la mesura."
    },
    {
      "desdeMs": 36000,
      "hastaMs": 38000,
      "texto": "No sé, vos estés preparada."
    },
    {
      "desdeMs": 39000,
      "hastaMs": 43000,
      "texto": "Espero que no sigan pecando."
    },
    {
      "desdeMs": 44000,
      "hastaMs": 45000,
      "texto": "¡No sé!"
    }
  ],
